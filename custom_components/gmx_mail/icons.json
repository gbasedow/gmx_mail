{
  "services": {
    "list_folders": {
      "service": "mdi:folder-multiple-outline"
    },
    "search": {
      "service": "mdi:email-search-outline"
    },
    "get_message": {
      "service": "mdi:email-open-outline"
    },
    "get_attachment": {
      "service": "mdi:paperclip"
    },
    "get_status": {
      "service": "mdi:information-outline"
    },
    "get_audit_log": {
      "service": "mdi:clipboard-text-clock-outline"
    },
    "set_flags": {
      "service": "mdi:flag-outline"
    },
    "move": {
      "service": "mdi:folder-move-outline"
    },
    "copy": {
      "service": "mdi:content-copy"
    },
    "mark_spam": {
      "service": "mdi:email-alert"
    },
    "mark_not_spam": {
      "service": "mdi:email-check-outline"
    },
    "create_folder": {
      "service": "mdi:folder-plus-outline"
    },
    "rename_folder": {
      "service": "mdi:folder-edit-outline"
    },
    "save_draft": {
      "service": "mdi:email-edit-outline"
    }
  },
  "entity": {
    "sensor": {
      "unseen_inbox": {
        "default": "mdi:email-alert-outline"
      },
      "junk_messages": {
        "default": "mdi:email-remove-outline"
      },
      "last_sync": {
        "default": "mdi:sync"
